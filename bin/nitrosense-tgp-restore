#!/usr/bin/env bash
# Restore the last NVIDIA TGP from ~/.config/nitrosense/ui.json (silent at login).
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
if [[ -d "$HERE/../nitrosense" ]]; then
  ROOT="$(cd "$HERE/.." && pwd)"
elif [[ -d /usr/share/nitrosense/nitrosense ]]; then
  ROOT=/usr/share/nitrosense
else
  echo "nitrosense: application files not found" >&2
  exit 1
fi
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m nitrosense.gpu "$@"
