#!/usr/bin/env python3
"""Privileged writes: Linuwu sysfs and NVIDIA TGP. Paths outside the allow-list are rejected."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ALLOWED_PREFIXES = (
    Path("/sys/module/linuwu_sense"),
    Path("/sys/devices/platform/acer-wmi"),
    Path("/sys/firmware/acpi/platform_profile"),
)

ALLOWED_NAMES = {
    "fan_speed",
    "battery_limiter",
    "battery_calibration",
    "usb_charging",
    "backlight_timeout",
    "lcd_override",
    "boot_animation_sound",
    "four_zone_mode",
    "per_zone_mode",
    "platform_profile",
    "pwm1",
    "pwm2",
    "pwm1_enable",
    "pwm2_enable",
}

MAX_VALUE = 256
TGP_MIN = 1
TGP_MAX = 999
POWERD_UNIT = Path("/etc/systemd/system/nvidia-powerd.service")
POWERD_DBUS = Path("/etc/dbus-1/system.d/nvidia-powerd.conf")
POWERD_LOG = Path("/var/log/nvtopps")


def _data_candidates(name: str) -> list[Path]:
    here = Path(__file__).resolve()
    roots = [
        here.parents[1] / "data",
        Path("/usr/share/nitrosense/data"),
        Path("/usr/share/nitrosense"),
    ]
    out = [root / name for root in roots]
    if name == "nvidia-powerd.service":
        out.extend(sorted(Path("/usr/share/doc").glob("nvidia-kernel-common-*/nvidia-powerd.service")))
    return out


def _copy_first(dest: Path, *names: str) -> bool:
    if dest.is_file():
        return True
    for name in names:
        for src in _data_candidates(name):
            if src.is_file():
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_text(src.read_text(encoding="utf-8"), encoding="utf-8")
                dest.chmod(0o644)
                return True
    return dest.is_file()


def _powerd_active() -> bool:
    return subprocess.run(
        ["systemctl", "is-active", "--quiet", "nvidia-powerd"],
        check=False,
    ).returncode == 0


def _set_powerd(enable: bool) -> bool:
    if not Path("/usr/bin/nvidia-powerd").is_file():
        print("nvidia-powerd is not installed", file=sys.stderr)
        return False
    _copy_first(POWERD_UNIT, "nvidia-powerd.service")
    dbus_new = not POWERD_DBUS.is_file()
    _copy_first(POWERD_DBUS, "nvidia-powerd-dbus.conf")
    POWERD_LOG.mkdir(parents=True, exist_ok=True)
    if dbus_new:
        subprocess.run(["systemctl", "reload", "dbus.service"], check=False)
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    if enable:
        subprocess.run(["systemctl", "enable", "--now", "nvidia-powerd.service"], check=False)
    else:
        subprocess.run(["systemctl", "disable", "--now", "nvidia-powerd.service"], check=False)
    return _powerd_active() == enable


def _smi_limits() -> tuple[int | None, int | None, int | None]:
    result = subprocess.run(
        [
            "nvidia-smi",
            "--query-gpu=enforced.power.limit,power.default_limit,power.max_limit",
            "--format=csv,noheader,nounits",
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None, None, None

    def _n(raw: str) -> int | None:
        raw = raw.strip().replace("[N/A]", "")
        try:
            return int(round(float(raw)))
        except ValueError:
            return None

    parts = [p.strip() for p in result.stdout.strip().splitlines()[0].split(",")]
    cur = _n(parts[0]) if parts else None
    default = _n(parts[1]) if len(parts) > 1 else None
    maximum = _n(parts[2]) if len(parts) > 2 else None
    return cur, default, maximum


def _tgp(raw: str) -> int:
    try:
        watts = int(raw)
    except ValueError:
        print("TGP must be an integer wattage", file=sys.stderr)
        return 2
    if watts < TGP_MIN or watts > TGP_MAX:
        print("TGP out of range", file=sys.stderr)
        return 2
    result = subprocess.run(
        ["nvidia-smi", "-pl", str(watts)],
        check=False,
        capture_output=True,
        text=True,
    )
    out = ((result.stdout or "") + (result.stderr or "")).strip()
    pl_ok = result.returncode == 0 and "not supported" not in out.lower()
    _cur, default, maximum = _smi_limits()
    want_boost = maximum is not None and watts >= maximum - 1
    if default is not None and maximum is None:
        want_boost = watts > default
    if not _set_powerd(want_boost):
        if want_boost:
            print(out or "could not enable NVIDIA Dynamic Boost (nvidia-powerd)", file=sys.stderr)
            return 1
        # Turning boost off: still OK if -pl worked or powerd is simply absent.
        if Path("/usr/bin/nvidia-powerd").is_file():
            print("could not stop nvidia-powerd", file=sys.stderr)
            return 1
    if pl_ok or _powerd_active() is want_boost:
        return 0
    print(out or "could not set GPU power limit", file=sys.stderr)
    return 1


def _allowed(path: Path) -> bool:
    resolved = path.resolve()
    if resolved.name not in ALLOWED_NAMES:
        return False
    for prefix in ALLOWED_PREFIXES:
        try:
            resolved.relative_to(prefix)
            return True
        except ValueError:
            continue
    if resolved.name in {"pwm1", "pwm2", "pwm1_enable", "pwm2_enable"}:
        try:
            name = (resolved.parent / "name").read_text(encoding="utf-8").strip()
        except OSError:
            return False
        return name in {"acer", "acer_wmi"}
    return False


def _write(path: Path, value: str) -> int:
    if "\n" in value or len(value) > MAX_VALUE:
        print("invalid value", file=sys.stderr)
        return 2
    if not _allowed(path):
        print(f"path rejected: {path}", file=sys.stderr)
        return 3
    try:
        path.write_text(value + "\n", encoding="utf-8")
    except OSError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] == "tgp":
        return _tgp(argv[2])
    if len(argv) == 4 and argv[1] == "write":
        return _write(Path(argv[2]), argv[3])
    print("usage: nitrosense-helper write <path> <value> | tgp <watts>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
